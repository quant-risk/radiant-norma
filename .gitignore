# Go build artifacts — devem ser construídos por `make build`, não commit.
/backend/api
/backend/api-*
/backend/worker
/backend/worker-*
/backend/radar
/backend/radar-*
/backend/seed
/backend/seed-*
/backend/jwt-mint
/backend/jwt-mint-*
/backend/_verify
/_*.exe

# Database files — runtime SQLite.
*.db
*.db-shm
*.db-wal

# Migrations run output.
migrations/applied/

# Catalog extraction log (dev tool).
_catalogos/_extracao.log
_catalogos/*.log

# Test artifacts.
*.out
*.cover
*.html
coverage.txt
*.test

# Editor/OS noise.
.DS_Store
.idea/
.vscode/
*.swp

# Frontend (Next.js) — node_modules e build output não vão pro git.
# package-lock.json é commitado (lockfile de aplicação).
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
frontend/.env.local
frontend/.env.*.local
frontend/*.tsbuildinfo
frontend/next-env.d.ts.bak
